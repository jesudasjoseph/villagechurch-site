<Page title={story.title}>
  <h1
    class="text-storyprimary text-8xl font-bold w-full flex items-start font-playfair-display m-8 relative"
  >
    {story.title}
  </h1>
  <div class="bg-storysecondary ml-40 p-8 pt-10 -mt-4">
