---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import Excerpt from "../../components/story/Excerpt.astro";
import StoryBody from "../../components/story/StoryBody.astro";

export async function getStaticPaths() {
  const stories = await getCollection("story");
  console.log("stories", stories);
  return stories.map((data, index) => ({
    params: { id: data.data.slug },
    props: { story: data.data, index: index },
  }));
}

