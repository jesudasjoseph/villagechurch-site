---
const body: string = Astro.props.body;

let splitBody = body.split(". ");
let firstPart =
  splitBody.length > 8 ? splitBody.slice(0, 8).join(". ") + ". " : "";
let lastPart =
  splitBody.length > 8 ? splitBody.slice(8, -1).join(". ") + ". " : body;
---

<article class="font-quicksand font-medium text-lg indent-8">
  <span set:html={firstPart} />
  <slot name="excerpt" />
  <span set:html={lastPart} />
</article>
